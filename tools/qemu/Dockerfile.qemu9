# QEMU 9.2 (has the raspi4b machine: BCM2711, GIC with Security Extensions, 2 GB), patched by qemu9-patch.py, for the QEMU test on a Pi 4 model.
# docker build -t nativecall-qemu:3 -f Dockerfile.qemu9 .   (from tools/qemu)
FROM emu68-build:ubuntu24
RUN apt-get update && apt-get install -y --no-install-recommends build-essential ninja-build \
        python3 python3-venv pkg-config libglib2.0-dev libpixman-1-dev flex bison wget xz-utils \
        ca-certificates device-tree-compiler && rm -rf /var/lib/apt/lists/*
COPY qemu9-patch.py /tmp/
RUN cd /tmp && wget -q https://download.qemu.org/qemu-9.2.4.tar.xz && tar xf qemu-9.2.4.tar.xz \
    && python3 /tmp/qemu9-patch.py qemu-9.2.4 \
    && cd qemu-9.2.4 && ./configure --target-list=aarch64-softmmu --disable-docs --disable-werror \
        --disable-gtk --disable-sdl --disable-vnc --disable-opengl --disable-slirp --prefix=/usr/local \
    && make -j$(nproc) && make install && cd / && rm -rf /tmp/qemu-9.2.4*
